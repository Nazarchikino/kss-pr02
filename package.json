{
  "name": "helpdesk-ts",
  "version": "1.0.0",
  "description": "Практична робота № 2. Основи TypeScript: типи, інтерфейси, узагальнення, декоратори, налаштування компілятора",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test \"test/*.test.js\"",
    "typecheck:types": "tsc -p tsconfig.types.json",
    "check": "npm test && npm run typecheck:types",
    "start": "node dist/main.js"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  }
}
